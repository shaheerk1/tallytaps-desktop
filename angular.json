{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "pos-shell": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css"
        }
      },
      "root": "apps/desktop/angular",
      "sourceRoot": "apps/desktop/angular/src",
      "prefix": "pos",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/pos-shell",
            "index": "apps/desktop/angular/src/index.html",
            "main": "apps/desktop/angular/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/desktop/angular/tsconfig.app.json",
            "assets": [
              "apps/desktop/angular/src/assets",
              {
                "glob": "small_icon.png",
                "input": ".",
                "output": "assets"
              },
              {
                "glob": "**/*",
                "input": "sidebaricons",
                "output": "assets/sidebaricons"
              }
            ],
            "styles": [
              "apps/desktop/angular/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "550kb",
                  "maximumError": "1300kb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "48kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "pos-shell:build:production"
            },
            "development": {
              "buildTarget": "pos-shell:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "apps/desktop/angular/tsconfig.spec.json",
            "assets": [
              "apps/desktop/angular/src/assets",
              {
                "glob": "small_icon.png",
                "input": ".",
                "output": "assets"
              },
              {
                "glob": "**/*",
                "input": "sidebaricons",
                "output": "assets/sidebaricons"
              }
            ],
            "styles": [
              "apps/desktop/angular/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
